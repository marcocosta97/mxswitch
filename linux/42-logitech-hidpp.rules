# Allow the logged-in user to talk HID++ to Logitech devices via hidraw.
#
#   sudo cp 42-logitech-hidpp.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# TAG+="uaccess" hands access to whoever is logged in at the seat, which is
# preferable to a group: no need to add yourself to plugdev and log out again.
#
# Two cases: USB (including Unifying/Bolt receivers) exposes idVendor on the
# device or an ancestor, but a Bluetooth HID device lives on bus 0005 and has
# no Logitech idVendor, so it needs its own match on the HID_ID kernel name.

# USB-connected receivers and devices, and USB-cabled devices.
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", MODE="0660", TAG+="uaccess"

# Bluetooth-connected devices (HID_ID is 0005:046D:xxxx).
KERNEL=="hidraw*", KERNELS=="0005:046D:*", MODE="0660", TAG+="uaccess"
